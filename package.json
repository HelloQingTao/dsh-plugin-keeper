{
  "name": "dsh-plugin-keeper",
  "version": "0.1.0",
  "description": "插件运维台：按来源分组盘点插件、检查更新、多选批量更新/停用/卸载 | Plugin ops console for DeepSeek Harness: source-grouped plugin inventory, update checks, batch update/disable/uninstall",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/design-plan.md"
  ],
  "license": "MIT",
  "author": "HelloQingTao",
  "homepage": "https://github.com/HelloQingTao/dsh-plugin-keeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloQingTao/dsh-plugin-keeper.git"
  },
  "bugs": {
    "url": "https://github.com/HelloQingTao/dsh-plugin-keeper/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "plugin-keeper",
    "batch-update",
    "batch-uninstall",
    "batch-disable",
    "update-check"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": [
        "0.2.0-rc.2",
        "0.2.1-rc.2"
      ]
    }
  }
}
